# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
.test-venv/
venv/

# .NET
bin/
obj/
*.dll
*.exe
*.pdb
*.nupkg

# Pipeline runtime
workspace/runs/*/
!workspace/runs/.gitkeep
workspace/backlog/
workspace/fixture-validation/
workspace/pr-dry-run/
# workspace/queues/ is intentionally tracked (completion queue is authority)

# Evidence bundles
workspace/verification/*.zip
workspace/verification/latest/*.zip
reports/**/*.zip

# Local planning files
/plans

# Local agent settings
.claude/
.env
.kilo/

# IDE
.idea/
.vscode/
*.suo
*.user

# Runtime validation artifacts (generated by dotnet run — must NOT be at repo root)
/input.pdf
/input.docx
/input.xlsx
/input.pptx
/input.vsdx
/input.eml
/input.html
/input.txt
/input.jpg
/input.png
/output.*
/test.pfx
*.pfx
*.pem
*.key
*.p12
# Exclude all artifact directories at root
/output.jpg/
/output.png/
/output.tiff/
/output.bmp/

# Generated pipeline snapshots
/leg.zip

# Local artifact staging (evidence bundles, not committed)
.local/

# GitLab CI pip cache (created by PIP_CACHE_DIR variable)
.pip-cache/

# OS
.DS_Store
Thumbs.db

# Build / runtime artifacts
/workspace
/reports
/reviews
.coverage
.runner_system_id
fallback_candidates.json
*output*
*input*
*template*
