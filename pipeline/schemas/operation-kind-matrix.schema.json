{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "operation-kind-matrix.schema.json",
  "title": "Operation Kind Matrix",
  "description": "Central matrix of operation kinds with cardinality semantics",
  "type": "object",
  "required": ["version", "operation_kinds"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "operation_kinds": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["description"],
        "properties": {
          "description": {
            "type": "string"
          },
          "input_cardinality": {
            "type": "string",
            "enum": ["none", "single", "multiple"]
          },
          "output_cardinality": {
            "type": "string",
            "enum": ["none", "single", "multiple"]
          }
        }
      }
    }
  }
}
