  "github_api_flow": {
    "method": "GitHub REST API via urllib (no extra deps)",
    "steps": [
      "GET /repos/{owner}/{repo}/git/ref/heads/{base} — get base branch commit SHA",
      "GET /repos/{owner}/{repo}/git/commits/{sha} — get base tree SHA",
      "POST /repos/{owner}/{repo}/git/blobs (×N) — upload each file as blob",
      "POST /repos/{owner}/{repo}/git/trees — create new tree",
      "POST /repos/{owner}/{repo}/git/commits — create commit",
      "POST /repos/{owner}/{repo}/git/refs — create branch pointing to commit",
      "POST /repos/{owner}/{repo}/pulls — open pull request",
      "POST /repos/{owner}/{repo}/issues/{n}/labels — add labels (optional, best-effort)"
    ]
