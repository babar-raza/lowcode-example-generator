{
  "template_version": "1.0",
  "sprint_id": "sprint87",
  "description": "README I/O contract template for new family onboarding",
  "fields": {
    "family": "REQUIRED — family name (e.g., 'ocr')",
    "examples": "REQUIRED — array of example objects",
    "example_schema": {
      "example_id": "REQUIRED — e.g., 'ocr-image-to-text'",
      "input_format": "REQUIRED — canonical input format (e.g., '.png')",
      "output_format": "REQUIRED — canonical output format (e.g., '.txt')",
      "api_class": "REQUIRED — LowCode API class (e.g., 'OcrProcessor')",
      "api_method": "REQUIRED — LowCode API method (e.g., 'Process')",
      "has_io_section": "REQUIRED — boolean, true if README has ## Input and Output",
      "readme_status": "REQUIRED — DRAFT | VERIFIED | PUBLISHED"
    }
  },
  "validation_rules": [
    "All examples must have non-null input_format and output_format",
    "api_class must match format-authority contract",
    "readme_status must be DRAFT for new families until verified",
    "has_io_section must be false until README I/O is actually written"
  ],
  "example_instance": {
    "family": "ocr",
    "examples": [
      {
        "example_id": "ocr-image-to-text",
        "input_format": ".png",
        "output_format": ".txt",
        "api_class": "TBD_AFTER_DISCOVERY",
        "api_method": "TBD_AFTER_DISCOVERY",
        "has_io_section": false,
        "readme_status": "DRAFT"
      }
    ]
  }
}
