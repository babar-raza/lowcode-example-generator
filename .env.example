# ============================================================================
# Environment Variables for plugin-examples pipeline
# Copy this file to .env and fill in your values. Never commit .env.
# ============================================================================

# --- GitHub Tokens ---

# Classic PAT (ghp_*) with `repo` scope. Required for live PR creation/merge.
# Fine-grained PATs do NOT work for org-owned repos (Git Data API limitation).
# Store as system/user env var; map to GITHUB_TOKEN before running live commands.
GH_TOKEN=                           # required for publishing

# Mapped from GH_TOKEN at runtime. Do not set independently.
# GITHUB_TOKEN is what the pipeline code actually reads.
GITHUB_TOKEN=                       # required for publishing (set from GH_TOKEN)

# --- Approval Gates ---

# Interactive approval tokens for live operations. Must be provided at runtime;
# do NOT store these as permanent env vars or CI secrets.
PLUGIN_EXAMPLES_LIVE_PUBLISH_APPROVAL=   # required for live PR creation
PLUGIN_EXAMPLES_MERGE_PR_APPROVAL=       # required for live PR merge

# --- LLM Endpoint ---

# Exclusive LLM provider: https://llm.professionalize.com/v1/
# The pipeline enforces this endpoint via approved_providers whitelist.
GPT_OSS_ENDPOINT=https://llm.professionalize.com/v1/   # required
GPT_OSS_MODEL=                                          # required (e.g. model name)
GPT_OSS_API_KEY=                                        # required (API key from your team lead)

# --- Legacy LLM (NOT APPROVED for production use) ---
# These exist in code for backward compatibility but are blocked by governance.
# LLM_API_KEY=
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OLLAMA_HOST=

# --- Reviewer ---

# Absolute path to the external reviewer executable (optional).
# If not set, reviewer-dependent gates are skipped.
EXAMPLE_REVIEWER_PATH=              # optional

# --- Metrics ---

# Telemetry and metrics collection. All optional.
AGENT_METRICS_ENABLED=false         # optional (true/false)
AGENT_METRICS_DRY_RUN=false         # optional (true/false, skip actual sends)
AGENT_METRICS_STRICT=false          # optional (true/false, fail on metric errors)
AGENT_METRICS_PRODUCTION_ENABLED=false  # optional (true/false)
AGENT_METRICS_ENDPOINT=             # optional (metrics collection URL)
AGENT_METRICS_TOKEN=                # optional (metrics auth token)

# --- Local Development ---

# Python path for running tests and CLI
# PYTHONPATH=src                    # set in shell, not .env
