{
  "title": "Agent Metrics Automatic LLM Capture Audit",
  "audit_date": "2026-05-06",
  "sprint": "gap-closure-sprint-2",
  "objective": "Verify every LLM inference call through the project router is automatically captured when metrics are enabled",
  "router_instrumentation": {
    "file": "src/plugin_examples/llm_router/router.py",
    "collector_field": "LLMRouter.metrics_collector: Any = None",
    "collector_type": "Instance-scoped (not global, not thread-local)",
    "instrumented_functions": {
      "_call_openai_compatible": {
        "captures": ["provider", "model", "success", "http_status", "prompt_tokens", "completion_tokens", "total_tokens", "token_usage_available", "duration_ms"],
        "token_source": "resp.json()['usage']['total_tokens']",
        "missing_usage_handling": "total_tokens=0, token_usage_available=False"
      },
      "_call_ollama": {
        "captures": ["provider", "model", "success", "total_tokens", "duration_ms"],
        "token_source": "resp.json().get('eval_count', 0) + resp.json().get('prompt_eval_count', 0)"
      }
    },
    "return_type_unchanged": true,
    "return_type": "str",
    "preflight_not_counted": true
  },
  "collector_model": {
    "file": "src/plugin_examples/metrics/models.py",
    "class": "MetricsCollector",
    "fields": {
      "enabled": "bool (default True)",
      "calls": "list[LLMCallRecord]",
      "token_usage": "property: sum of total_tokens",
      "api_calls_count": "property: len(calls)"
    },
    "disabled_behavior": "record_call() is a no-op, counts remain 0"
  },
  "pipeline_wiring": {
    "run_command": {
      "collector_source": "PipelineContext.metrics_collector (runner.py)",
      "passed_to": "LLMRouter constructor",
      "llm_call_sites": [
        "runner.py:579 (generation lambda)",
        "runner.py:699 (build repair)",
        "runner.py:759 (runtime repair)"
      ]
    },
    "non_run_commands": {
      "collector_source": "MetricsSession creates MetricsCollector internally or accepts one",
      "wiring": "_create_metrics_session() in __main__.py creates session with collector",
      "coverage": "All 11 non-run commands have MetricsSession wired in __main__.py"
    }
  },
  "two_collector_independence_test": {
    "test_file": "tests/unit/test_agent_metrics_config.py",
    "test_name": "TestMetricsCollector::test_two_collectors_independent",
    "result": "PASS — two LLMRouter instances accumulate independently"
  },
  "no_global_state": {
    "verified": true,
    "evidence": "MetricsCollector is instance-scoped on LLMRouter dataclass. No module-level mutable state. No singletons."
  },
  "test_coverage": [
    "test_agent_metrics_config.py::TestMetricsCollector (5 tests)",
    "test_agent_metrics_session.py::TestAutomaticLLMCapture (3 tests)",
    "test_agent_metrics_router.py (router instrumentation tests)"
  ],
  "verdict": "AUTOMATIC_CAPTURE_VERIFIED"
}
