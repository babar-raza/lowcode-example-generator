{
  "template_version": "2.0",
  "sprint_id": "sprint88",
  "description": "README I/O contract template with operation cardinality rules",
  "fields": {
    "family": "REQUIRED",
    "examples": "REQUIRED — array of example objects"
  },
  "example_schema": {
    "example_id": "REQUIRED — e.g., 'cells-pdf-converter'",
    "input_format": "REQUIRED — canonical input format",
    "output_format": "REQUIRED — canonical output format",
    "api_class": "REQUIRED — LowCode API class",
    "api_method": "REQUIRED — LowCode API method",
    "operation_kind": "REQUIRED — converter|splitter|merger|extractor|viewer|renderer|editor|locker|other",
    "cardinality": "REQUIRED — 1-to-1|1-to-N|N-to-1|1-to-stdout|1-to-files",
    "has_io_section": "REQUIRED — boolean",
    "readme_status": "REQUIRED — DRAFT|VERIFIED|PUBLISHED"
  },
  "operation_cardinality_rules": {
    "converter": {"cardinality": "1-to-1", "description": "Single input -> single output in different format"},
    "splitter": {"cardinality": "1-to-N", "description": "Single input -> multiple output files"},
    "merger": {"cardinality": "N-to-1", "description": "Multiple inputs -> single merged output"},
    "extractor": {"cardinality": "1-to-stdout", "description": "Single input -> extracted content (text/data)"},
    "viewer": {"cardinality": "1-to-1", "description": "Single input -> rendered view"},
    "renderer": {"cardinality": "1-to-1", "description": "Single input -> rendered output"},
    "editor": {"cardinality": "1-to-1", "description": "Single input -> modified output"},
    "locker": {"cardinality": "1-to-1", "description": "Single input -> secured output"},
    "compressor": {"cardinality": "1-to-1", "description": "Single input -> compressed output"}
  },
  "root_readme_rules": [
    "Root README lists all examples in the family with links",
    "Root README is separate from per-example READMEs",
    "Root README PRs (#2, #5, #7) are independent of README I/O PRs"
  ],
  "example_readme_rules": [
    "Each example has a README.md with ## Input and Output section",
    "I/O section describes input format, output format, and sample usage",
    "Format claims must match format-authority contract"
  ]
}
