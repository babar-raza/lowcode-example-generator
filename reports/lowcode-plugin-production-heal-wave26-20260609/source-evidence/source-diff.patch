+
+    assert pr.title.startswith("feat(plugins):")
+    assert "barcode" in pr.title.lower()
+    assert pr.branch == "lowcode/wave25/barcode-plugin-examples"
+    assert "4 packages" in pr.title or "4" in pr.title
