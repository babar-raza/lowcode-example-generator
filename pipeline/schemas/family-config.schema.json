{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FamilyConfig",
  "type": "object",
  "required": [
    "family",
    "display_name",
    "enabled",
    "status",
    "nuget",
    "plugin_detection",
    "github",
    "fixtures",
    "existing_examples",
    "generation",
    "validation",
    "llm"
  ],
  "properties": {
    "family": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "description": "If false, this config is never processed by the package watcher or monthly runner."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "disabled",
        "experimental",
        "discovery_only"
      ],
      "description": "active = in production pipeline. disabled = excluded entirely. experimental = runs but does not publish. discovery_only = NuGet resolution + reflection only, no generation."
    },
    "nuget": {
      "type": "object",
      "required": [
        "package_id",
        "version_policy"
      ],
      "properties": {
        "package_id": {
          "type": "string"
        },
        "version_policy": {
          "enum": [
            "latest-stable",
            "pinned"
          ]
        },
        "pinned_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "allow_prerelease": {
          "type": "boolean",
          "default": false,
          "description": "If false, pre-release NuGet versions are excluded from version resolution."
        },
        "target_framework_preference": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Ordered preference list. First matching lib/ folder wins."
        },
        "dependency_resolution": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "If true, .nuspec dependencies are downloaded and extracted for DllReflector dependency resolution."
            },
            "max_depth": {
              "type": "integer",
              "default": 2,
              "description": "Maximum transitive dependency depth to resolve."
            },
            "extra_packages": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Additional NuGet package IDs to download for DllReflector dependency resolution. Use when a required assembly is not declared in any nuspec TFM group for the primary package (e.g. Aspose.Drawing.Common for Aspose.OCR)."
            },
            "include_all_tfm_groups": {
              "type": "boolean",
              "default": false,
              "description": "When true, collects dependencies from ALL TFM groups in the primary nuspec (not just the best-matching group). Required for packages where the netstandard2.0 nuspec group omits dependencies that the DLL actually references (e.g. Aspose.PDF VectorData deps in net9.0/net10.0 groups)."
            }
          }
        }
      }
    },
    "plugin_detection": {
      "type": "object",
      "required": [
        "namespace_patterns"
      ],
      "properties": {
        "namespace_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "fallback_strategy": {
          "type": ["string", "null"],
          "enum": ["capability_registry", "heuristic_only", null],
          "default": null,
          "description": "When set, enables non-LowCode fallback discovery for this family. null = LowCode pipeline only (default)."
        }
      }
    },
    "github": {
      "type": "object",
      "required": [
        "official_examples_repo",
        "published_plugin_examples_repo"
      ],
      "properties": {
        "official_examples_repo": {
          "type": "object",
          "required": [
            "owner",
            "repo",
            "branch"
          ],
          "properties": {
            "owner": {
              "type": "string"
            },
            "repo": {
              "type": "string"
            },
            "branch": {
              "type": "string"
            },
            "fixture_paths": {
              "type": "array",
              "items": {"type": "string"},
              "default": ["Examples/Data"],
              "description": "Paths within the repo to scan for fixture files."
            },
            "extension_allowlist": {
              "type": "array",
              "items": {"type": "string"},
              "default": [".xlsx",".docx",".pdf",".dwg",".dxf",".svg",".ttf",".otf",".png",".jpg",".html",".zip",".xbrl",".glb",".3ds",".fbx",".tiff",".bmp",".odt",".csv",".eml",".vsdx",".sxc"],
              "description": "File extensions allowed for download. Files outside this list are skipped."
            },
            "max_file_size_bytes": {
              "type": "integer",
              "default": 5242880,
              "description": "Maximum individual fixture file size (5 MB default)."
            },
            "max_total_size_bytes": {
              "type": "integer",
              "default": 52428800,
              "description": "Maximum total batch download size (50 MB default)."
            },
            "synthetic_fallback_allowed": {
              "type": "boolean",
              "default": true,
              "description": "When true, fall back to synthetic fixtures if real download fails or GITHUB_TOKEN is absent."
            }
          }
        },
        "published_plugin_examples_repo": {
          "type": "object",
          "required": [
            "owner",
            "repo",
            "branch"
          ],
          "properties": {
            "owner": {
              "type": "string"
            },
            "repo": {
              "type": "string"
            },
            "branch": {
              "type": "string"
            }
          }
        },
        "central_repo_allowed": {
          "type": "boolean",
          "default": false,
          "description": "When false (default), live publishing is blocked if published_plugin_examples_repo appears to be a central shared repository not specific to this family. Set to true only with an explicit human approval decision that the target repo is shared by design."
        }
      }
    },
    "fixtures": {
      "type": "object",
      "required": [
        "sources"
      ],
      "properties": {
        "sources": {
          "type": "array"
        }
      }
    },
    "existing_examples": {
      "type": "object",
      "required": [
        "sources"
      ],
      "properties": {
        "sources": {
          "type": "array"
        }
      }
    },
    "generation": {
      "type": "object",
      "required": [
        "min_examples_per_family",
        "max_examples_per_monthly_run"
      ],
      "properties": {
        "min_examples_per_family": {
          "type": "integer",
          "minimum": 1
        },
        "max_examples_per_monthly_run": {
          "type": "integer",
          "minimum": 1
        },
        "allow_new_fixtures": {
          "type": "boolean"
        },
        "allow_generated_input_files": {
          "type": "boolean"
        },
        "allowed_types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional allowlist of type short-names (e.g. Converter, Splitter). When non-empty, only these types are planned as generation scenarios. Used for controlled pilots."
        },
        "preferred_methods_per_type": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Optional map of type short-name to preferred primary method (e.g. {Watermarker: SetText}). When set, the specified method is placed first in target_methods so the LLM demonstrates it as the primary operation."
        }
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "require_restore": {
          "type": "boolean"
        },
        "require_build": {
          "type": "boolean"
        },
        "require_run": {
          "type": "boolean"
        },
        "require_output_validation": {
          "type": "boolean"
        },
        "require_example_reviewer": {
          "type": "boolean"
        },
        "runtime_runner": {
          "type": "string",
          "enum": [
            "linux",
            "windows",
            "auto"
          ],
          "default": "auto",
          "description": "auto = linux unless only .NET Framework assemblies are available, in which case windows is required."
        }
      }
    },
    "llm": {
      "type": "object",
      "required": [
        "provider_order"
      ],
      "properties": {
        "provider_order": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "discovery_mode": {
      "type": "string",
      "enum": ["read_only", "dry_run", "publication"],
      "default": "dry_run",
      "description": "Controls discovery freshness and version drift gates. publication = hard-stop on stale; dry_run = warn; read_only = warn without refresh."
    },
    "template_hints": {
      "type": "object",
      "description": "Optional hints for data-driven template generation. All fields have defaults.",
      "properties": {
        "default_input_extension": {
          "type": "string"
        },
        "default_input_filename": {
          "type": "string"
        },
        "array_input_filenames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "input_creation_lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "merger_input_creation_lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "additional_usings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "default_output_extension": {
          "type": "string"
        },
        "default_fixture_extension": {
          "type": "string"
        }
      }
    }
  }
}
