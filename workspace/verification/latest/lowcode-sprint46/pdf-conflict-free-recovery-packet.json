  "recovery_commands": [
    "# Step 1: Set approval gates",
    "export PLUGIN_EXAMPLES_LIVE_PUBLISH_APPROVAL=APPROVE_LIVE_PR",
    "export PLUGIN_EXAMPLES_MERGE_PR_APPROVAL=APPROVE_MERGE_PR",
    "",
    "# Step 2: Close existing PRs",
    "for pr in 5 6 7 8 9 10; do gh pr close $pr --repo aspose-pdf-net/Aspose.PDF.LowCode-for-.NET-Examples; done",
    "",
    "# Step 3: Recreate PRs via pipeline",
    "PYTHONPATH=src .venv/Scripts/python.exe -m plugin_examples publish-pr --family pdf --publish --approval-token APPROVE_LIVE_PR --package-path workspace/pr-dry-run/pdf-controlled-pilot/",
    "PYTHONPATH=src .venv/Scripts/python.exe -m plugin_examples publish-pr --family pdf --publish --approval-token APPROVE_LIVE_PR --package-path workspace/pr-dry-run/pdf-controlled-pilot-pr5/",
    "PYTHONPATH=src .venv/Scripts/python.exe -m plugin_examples publish-pr --family pdf --publish --approval-token APPROVE_LIVE_PR --package-path workspace/pr-dry-run/pdf-controlled-pilot-pr6/",
    "PYTHONPATH=src .venv/Scripts/python.exe -m plugin_examples publish-pr --family pdf --publish --approval-token APPROVE_LIVE_PR --package-path workspace/pr-dry-run/pdf-controlled-pilot-pr7/",
    "PYTHONPATH=src .venv/Scripts/python.exe -m plugin_examples publish-pr --family pdf --publish --approval-token APPROVE_LIVE_PR --package-path workspace/pr-dry-run/pdf-controlled-pilot-pr8/",
    "PYTHONPATH=src .venv/Scripts/python.exe -m plugin_examples publish-pr --family pdf --publish --approval-token APPROVE_LIVE_PR --package-path workspace/pr-dry-run/pdf-controlled-pilot-pr9/",
    "",
    "# Step 4: Verify PRs are conflict-free",
    "for pr in $(gh pr list --repo aspose-pdf-net/Aspose.PDF.LowCode-for-.NET-Examples --json number -q '.[].number'); do gh pr view $pr --repo aspose-pdf-net/Aspose.PDF.LowCode-for-.NET-Examples --json mergeable -q '.mergeable'; done",
    "",
    "# Step 5: Merge PRs (after verification)",
    "PYTHONPATH=src .venv/Scripts/python.exe -m plugin_examples merge-pr --family pdf --pr-number <NEW_PR_NUMBER> --merge --approval-token APPROVE_MERGE_PR"
  ],
  "rollback": "If any recreated PR fails, close it. The original local package is preserved. Re-run publish-pr.",
  "validation": "After merge, verify: target repo main has all 19 examples, README is current, conservation still passes."
